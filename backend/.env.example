# UniPak Backend Configuration
PORT=3000
NODE_ENV=development

# SQL Server Database Configuration
DB_HOST=localhost
DB_PORT=1433
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=UniPak

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# AI assistant (keep the real key only in .env or a secret manager)
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-20b

# Support email notifications (Resend)
RESEND_API_KEY=
SUPPORT_NOTIFICATION_EMAIL=
SUPPORT_FROM_EMAIL=UniPak Support <onboarding@resend.dev>

# Opt in only when SQL Server presents a valid trusted certificate
DB_VERIFY_CERTIFICATE=false

# Comma-separated website origins; empty or * preserves unrestricted CORS.
# Production example: https://your-domain.example,https://www.your-domain.example

# Separate generous quotas per client IP (or proxy IP when proxy trust is off).
# Counters are in memory per server process and reset on restart.
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=600
SUPPORT_RATE_LIMIT_WINDOW_MS=900000
SUPPORT_RATE_LIMIT_MAX=120
